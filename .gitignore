# secrets & runtime state — never commit
# working material: notes and captures that belong to no release
runs/

.env
*.env
!*.env.example
deploy/.env.*
# ...but NOT the example, which is a source file, not a secret. `!*.env.example` above is
# overridden by the line before this one — last match wins — so deploy/.env.example was
# untracked: a clean clone had no configuration surface at all, and the release bundle tars
# that file to satisfy the installer's very first command, `cp .env.example .env`.
!deploy/.env.example
hermes-data/
**/data/
zz-artifacts/
credentials.json

# python / os noise
__pycache__/
*.pyc
.DS_Store
*.pem
*.key
node_modules/
dist/
*.tsbuildinfo


# documentation is kept locally, not published with the package
docs/

# The HTML reports and JSON `claude plugin eval` leaves behind. The RESULT is recorded in
# zz.plugin_case_run by case_record, which is what gives it a timestamp; the directory
# is a local by-product of the run that produced it.
evals/results/
**/evals/results/
