{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "zz-block-eval",
  "agentName": "ZZ Block Evaluation",
  "version": "0.1.0",
  "description": "Measure an MCP surface: what it offers, what it honours of the standard, and what it does that its documentation does not describe. Points at any registered block — including 'platform', which is this platform's own surface.",
  "shelved": true,
  "entry": "zz-block-eval",
  "tools": [],
  "servers": [
    {
      "name": "zz-core",
      "path": "/mcp"
    },
    {
      "name": "cred-manage",
      "path": "/manage/mcp"
    }
  ],
  "stages": [
    {
      "name": "zz-block-locate"
    },
    {
      "name": "zz-block-measure"
    },
    {
      "name": "zz-block-report"
    }
  ],
  "documents": [
    {
      "name": "findings.md",
      "role": "verification",
      "gate": true,
      "closing": true,
      "requiredForClose": true,
      "sections": [
        "What we found",
        "What we ask for",
        "Defects",
        "What we changed on our side",
        "What we are not claiming",
        "What was evaluated",
        "What the numbers say"
      ],
      "stage": "zz-block-report"
    }
  ],
  "install": "auto",
  "license": "MIT"
}
