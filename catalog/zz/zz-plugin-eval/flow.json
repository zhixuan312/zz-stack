{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "zz-plugin-eval",
  "agentName": "ZZ Plugin Evaluation",
  "description": "Measure a whole plugin by what its real runs did. One protocol you agree, evidence and never a change.",
  "purpose": "To answer whether a plugin is worth having, from evidence the platform already holds — what its real runs did — against a protocol somebody agreed before the scoring started. It measures and never changes what it measures.",
  "entry": "zz-plugin-eval",
  "commands": {
    "eval": "zz-plugin-eval"
  },
  "servers": [
    {
      "name": "zz-plugin-eval",
      "path": "/eval/mcp"
    }
  ],
  "stages": [
    {
      "name": "zz-plugin-locate",
      "produces": "nothing"
    },
    {
      "name": "zz-plugin-profile",
      "produces": "record"
    },
    {
      "name": "zz-plugin-define",
      "produces": "protocol.md"
    },
    {
      "name": "zz-plugin-judge",
      "produces": "record"
    },
    {
      "name": "zz-plugin-report",
      "produces": "findings.md"
    }
  ],
  "documents": [
    {
      "name": "protocol.md",
      "role": "agreement",
      "gate": true,
      "sections": [
        "The plugin under evaluation",
        "What good means here",
        "The evidence each dimension reads"
      ],
      "stage": "zz-plugin-define"
    },
    {
      "name": "findings.md",
      "role": "verification",
      "requires": "protocol.md",
      "closing": true,
      "requiredForClose": true,
      "sections": [
        "Outcome",
        "What is good",
        "What is bad",
        "What to do to improve it",
        "What this does not establish"
      ],
      "gate": true,
      "stage": "zz-plugin-report"
    }
  ],
  "license": "MIT"
}
