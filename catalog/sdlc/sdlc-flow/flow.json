{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "sdlc-flow",
  "agentName": "SDLC Agent",
  "version": "0.2.0",
  "description": "Software delivery: explore the ground, agree a spec, audit it, plan it, audit that, build it, review the code, then close it and hand it to zz-knowledge. sdlc-flow is the entry point, sdlc-method says how every stage is executed, and each stage is its own skill.",
  "license": "MIT",
  "keywords": [
    "delivery",
    "engineering",
    "methodology",
    "flow"
  ],
  "entry": "sdlc-flow",
  "tools": [],
  "standalone": [
    "sdlc-deck",
    "sdlc-tldr",
    "sdlc-breakout"
  ],
  "stages": [
    {
      "name": "sdlc-explore"
    },
    {
      "name": "sdlc-spec"
    },
    {
      "name": "sdlc-spec-audit"
    },
    {
      "name": "sdlc-plan"
    },
    {
      "name": "sdlc-plan-audit"
    },
    {
      "name": "sdlc-execute"
    },
    {
      "name": "sdlc-review"
    }
  ],
  "documents": [
    {
      "name": "explore.md",
      "role": "ground",
      "sections": [
        "Background",
        "Current state",
        "Rough direction"
      ],
      "stage": "sdlc-explore"
    },
    {
      "name": "spec.md",
      "role": "agreement",
      "gate": true,
      "requires": "explore.md",
      "closing": true,
      "sections": [
        "Context",
        "Problem",
        "Goals & Requirements",
        "Alternatives",
        "Approach, Method & Structure",
        "Verification Plan",
        "Risks & Mitigations",
        "Stakeholders & Work"
      ],
      "stage": "sdlc-spec"
    },
    {
      "name": "plan.md",
      "role": "plan",
      "gate": true,
      "requires": "spec.md",
      "sections": [
        "Full-suite gate"
      ],
      "stage": "sdlc-plan"
    }
  ]
}
