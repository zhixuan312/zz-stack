# Public entry points for ZZ Stack.
#
# Two hostnames, one machine, one deployment:
#
#   console.example.com       the console — the only dashboard this deployment has
#   api.example.com           the platform gateway — every non-browser client
#
# DELIBERATE: this file is a template, and `install-caddy.sh` is the only thing that should
# apply it. It substitutes the console's hostname from CONSOLE_PUBLIC_URL, the gateway's from
# GATEWAY_PUBLIC_URL and the upstream below for wherever the gateway is actually published, then
# refuses the install if any literal survived. Copying this file onto a host by hand skips every
# guard.
#
# One thing differs per host: how Caddy reaches the gateway on port 8764. Here it is loopback,
# because the gateway is published on 127.0.0.1. A host that binds it to a tailnet address
# needs that address, and install-caddy.sh reads the real one off the running container.
#
# Both hostnames need an A record to this machine, DNS only: a proxying CDN cuts an idle response
# at about 100 seconds, and the timeouts below are 30 minutes because a turn runs that long. Caddy
# issues both certificates itself. The api. host exists because an MCP client runs on somebody's
# laptop and needs a public route in.
#
# After changing this file:
#   1. set GATEWAY_PUBLIC_URL=https://api.example.com in deploy/.env
#      — every generated client package embeds this value, so a stale one ships
#      unreachable URLs to every person who installs
#   2. set CONSOLE_PUBLIC_URL=https://console.example.com in deploy/.env — its hostname is the
#      passkey relying party, so changing it makes everybody re-enrol
#   3. docker compose up -d cred-proxy zz-core
#   4. run deploy/install-caddy.sh — do not copy it by hand

# An agent turn runs for minutes: tens of sequential tool calls, each a round trip to a door,
# and Caddy's defaults would sever the response mid-turn.
#
# DELIBERATE: global options. `timeouts` is not a site directive — inside a site block Caddy
# rejects the whole file, `systemctl reload` fails, and the old config stays loaded.
{
    servers {
        timeouts {
            read_body   5m
            read_header 1m
            write       30m
            idle        30m
        }
    }
}

# The gateway, for every non-browser client.
api.example.com {
    # /internal/* is the gateway's agent door, which zz-core calls on the compose network and
    # nobody calls from outside (services/gateway/src/agent-door.ts). The gateway refuses any peer
    # but zz-core already; this answers 404 before the proxy, so a request from outside fails twice.
    # Caddy's directive order puts `respond` ahead of `reverse_proxy` too, wherever it is written.
    respond /internal/* 404

    # The gateway authenticates every request itself (Bearer zzp_… resolved against zz.pat), so
    # this proxy adds no authorisation of its own and must not strip the Authorization header.
    reverse_proxy 127.0.0.1:8764 {
        flush_interval -1
        transport http {
            read_timeout 30m
        }
    }

    # A cap on what a client may send, not on what it receives: a body cap never touches a
    # response, and the long-lived response on THIS host is streamed — an MCP turn's reply is an
    # SSE stream, one the transport closes when the last reply is sent (`packages/mcp-http`).
    # 20MB is far above any MCP call and far below anything worth buffering.
    request_body {
        max_size 20MB
    }
}

# The console: the admin dashboard.
#
# DELIBERATE: one host, split on path. The sign-in cookie the gateway sets is host-only and
# SameSite=Lax; serving the app from one origin and its API from another would make it a
# third-party cookie that every browser may drop. Same origin also means no CORS and no
# preflight.
#
#   /auth/*          the passkey ceremony and logout            → gateway
#   /oauth/*         the authorize step of the gateway's OAuth  → gateway
#   /api/console/*   the read API                                → gateway
#   everything else  the Next app                                → console
console.example.com {
    handle /auth/* {
        reverse_proxy 127.0.0.1:8764
    }
    # COUPLED: /oauth/authorize lives where the session cookie lives. The authorize endpoint asks
    # who is at this keyboard, and the answer is the `zz_console` cookie that /auth/* sets
    # host-only, so api.<host> cannot read it. Discovery, /oauth/register and /oauth/token stay on
    # api.: they are called by an MCP client, which has no cookie and needs none.
    handle /oauth/* {
        reverse_proxy 127.0.0.1:8764
    }
    handle /api/console/* {
        # -1 disables response buffering. The discussion thread is server-sent events, and a
        # buffering proxy holds a stream until the connection closes — the feature silently never
        # updates.
        reverse_proxy 127.0.0.1:8764 {
            flush_interval -1
        }
    }
    handle {
        reverse_proxy 127.0.0.1:3100
    }
}

