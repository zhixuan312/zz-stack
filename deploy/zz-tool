#!/usr/bin/env bash
# Run one of the platform's own tools on a deployment host.
#
#   ./deploy/zz-tool call /core/mcp session_whoami
#   ./deploy/zz-tool audit --manifest /catalog/sdlc/sdlc-flow/flow.json --store /artifacts/teams/<team>
#   ./deploy/zz-tool register-skills
#   ./deploy/zz-tool                       # list what there is
#
# DELIBERATE: the tools run in the image already on the host. A deploy host runs containers and
# has no toolchain; the image carries node and the compiled tools, so nothing new is installed
# and a tool cannot be a different version from the services it talks to.
#
# On the compose network, so service names resolve — and a tool's own defaults do not apply
# here. A default of 127.0.0.1 means, inside a one-shot container, that container: pass the
# service name instead.
#
#   --gateway http://cred-proxy:8000
#
# DELIBERATE: no docker socket. Mounting it would give a one-shot command root on the host,
# and no tool here needs it.
set -euo pipefail
cd "$(dirname "$0")"

declare -A TOOLS=(
  [call]=ops/call
  # A deploy host has no toolchain, so a tool absent from this map cannot be run where it
  # matters.
  [register-skills]=ops/register-skills
  [register-plugins]=ops/register-plugins
  # plugin-surface reads back the surface zz-core records at boot.
  [plugin-surface]=ops/plugin-surface
  [audit]=testing/manifest-audit
  [chain-check]=testing/chain-check
  [tool-report]=testing/tool-report
  [evolve-report]=testing/evolve-report
  [step-score]=testing/step-score
  [skill-reflect]=testing/skill-reflect
  # PROMOTE/VERIFY's own two commands (Task I-28): apply an approved candidate's patch and run
  # the repository's release procedure against it, or run the repository's rollback procedure
  # over a release_verify verdict of rolled_back. Both operate on a throwaway clone, never the
  # primary checkout — see each tool's own --repo argument.
  [release-apply]=release/apply
  [release-rollback]=release/rollback
  [watch-results]=ops/watch-results
  [sql-check]=testing/sql-check
)

name="${1:-}"
if [ -z "$name" ] || [ -z "${TOOLS[$name]:-}" ]; then
  [ -n "$name" ] && echo "no tool called '$name'." >&2
  echo "usage: $0 <tool> [args…]" >&2
  echo "tools: $(echo "${!TOOLS[@]}" | tr ' ' '\n' | sort | tr '\n' ' ')" >&2
  exit 2
fi
shift

# Pass through the variables the tools read, and only those. `docker compose run -e NAME`
# without a value forwards this shell's value when it is set and leaves it unset otherwise, so
# an unset secret never arrives as an empty string a tool would treat as supplied.
#
# COUPLED: every name here is read by a tool this repository has, and the gate holds that.
pass=()
for v in ZZ_PAT ZZ_TOKEN ZZ_TOKEN_FILE ZZ_URL ZZ_GATEWAY CHAIN_FLOW \
         PLATFORM_BASE_MODEL LLM_BASE_URL LLM_API_KEY JUDGE_MODEL TEAM_DB_URL \
         ZZ_CATALOG_OWNER_TEAM; do
  [ -n "${!v:-}" ] && pass+=(-e "$v")
done

# `-T`: no TTY. Nothing here is interactive, and with one allocated an ssh session that
# launched a long run never returns, so a launch cannot be told from a hang. It also keeps
# output line-buffered, which is what a log wants.
exec docker compose run --rm --no-deps -T "${pass[@]}" \
  --entrypoint node zz-core "/repo/packages/tools/dist/${TOOLS[$name]}.js" "$@"
