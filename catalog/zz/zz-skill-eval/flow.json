{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "zz-skill-eval",
  "agentName": "ZZ Skill Evaluation",
  "version": "0.1.0",
  "description": "Measure a skill: its statistics first, then its definition of good, then its documents if it writes any. Produces evidence, never a change.",
  "shelved": true,
  "entry": "zz-skill-eval",
  "tools": [],
  "servers": [
    {
      "name": "zz-core",
      "path": "/mcp"
    },
    {
      "name": "cred-manage",
      "path": "/manage/mcp"
    }
  ],
  "stages": [
    {
      "name": "zz-skill-locate"
    },
    {
      "name": "zz-skill-profile"
    },
    {
      "name": "zz-skill-define"
    },
    {
      "name": "zz-skill-judge"
    },
    {
      "name": "zz-skill-report"
    }
  ],
  "documents": [
    {
      "name": "rulers.md",
      "role": "agreement",
      "gate": true,
      "sections": [
        "Skills in scope",
        "The ruler for each version",
        "What changed"
      ],
      "stage": "zz-skill-define"
    },
    {
      "name": "findings.md",
      "role": "verification",
      "requires": "rulers.md",
      "closing": true,
      "requiredForClose": true,
      "sections": [
        "The verdict",
        "What we can rely on",
        "Recommendation",
        "What the numbers say",
        "Why the measurement is or is not trustworthy",
        "What this does not say",
        "What was evaluated"
      ],
      "gate": true,
      "stage": "zz-skill-report"
    }
  ],
  "install": "auto",
  "license": "MIT"
}
