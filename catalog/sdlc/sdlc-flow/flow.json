{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "sdlc-flow",
  "agentName": "SDLC Agent",
  "description": "Software delivery: explore the ground, agree a spec, audit it, plan it, audit that, build it, review the code, then close it and hand it to zz-handover. sdlc-flow is the entry point, sdlc-method says how every stage is executed, and each stage is its own skill.",
  "purpose": "To carry one piece of delivery work from a raw idea to a shipped, reviewed change without anybody having to remember the order — each stage a skill, each gate a document a person approves. Work belongs here when it changes a system somebody operates; a question with one answer is an investigation, not a flow.",
  "license": "MIT",
  "keywords": [
    "delivery",
    "engineering",
    "methodology",
    "flow"
  ],
  "entry": "sdlc-flow",
  "commands": {
    "flow": "sdlc-flow"
  },
  "libraries": [
    "sdlc-method",
    "sdlc-audit-criteria",
    "sdlc-investigate",
    "sdlc-recall",
    "sdlc-research"
  ],
  "stages": [
    {
      "name": "sdlc-explore",
      "produces": "explore.md"
    },
    {
      "name": "sdlc-spec",
      "produces": "spec.md"
    },
    {
      "name": "sdlc-spec-audit",
      "produces": "source",
      "supports": "spec.md"
    },
    {
      "name": "sdlc-plan",
      "produces": "plan.md"
    },
    {
      "name": "sdlc-plan-audit",
      "produces": "source",
      "supports": "plan.md"
    },
    {
      "name": "sdlc-execute",
      "produces": "nothing"
    },
    {
      "name": "sdlc-review",
      "produces": "review.md"
    }
  ],
  "documents": [
    {
      "name": "explore.md",
      "role": "ground",
      "sections": [
        "Background",
        "Current state",
        "Rough direction"
      ],
      "stage": "sdlc-explore"
    },
    {
      "name": "spec.md",
      "role": "agreement",
      "gate": true,
      "requires": "explore.md",
      "sections": [
        "Context",
        "Problem",
        "Goals & Requirements",
        "Alternatives",
        "Approach, Method & Structure",
        "Verification Plan",
        "Risks & Mitigations",
        "Stakeholders & Work"
      ],
      "stage": "sdlc-spec"
    },
    {
      "name": "plan.md",
      "role": "plan",
      "gate": true,
      "requires": "spec.md",
      "sections": [
        "Full-suite gate"
      ],
      "stage": "sdlc-plan"
    },
    {
      "name": "review.md",
      "role": "verification",
      "gate": true,
      "closing": true,
      "requiredForClose": true,
      "requires": "plan.md",
      "stage": "sdlc-review"
    }
  ]
}
