# secrets & runtime state — never commit
# working material: notes and captures that belong to no release
runs/

.env
*.env
!*.env.example
deploy/.env.*
# DELIBERATE: the example is a source file, and last match wins, so it is re-included after the
# line above. The release bundle ships it for the installer's first command,
# `cp .env.example .env`.
!deploy/.env.example
**/data/
zz-artifacts/
credentials.json

# python / os noise
__pycache__/
*.pyc
.DS_Store
*.pem
*.key
node_modules/
dist/
*.tsbuildinfo

# build-marketplace.ts compiles catalog/**/skills/**/*.ts here before packaging, so the
# marketplace/ tree never sees the .ts source beside the .js it ships. Rebuilt per invocation.
.marketplace-staging/


# documentation is kept locally, not published with the package
docs/

# The HTML reports and JSON `claude plugin eval` leaves behind: local by-products of a run.
evals/results/
**/evals/results/
