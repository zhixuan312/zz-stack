{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "zz-plugin-eval",
  "agentName": "ZZ Plugin Evaluation",
  "description": "Measure a whole plugin by what its real runs did, then — for plugins this team owns — search for a proven, authorized improvement. One protocol you agree, evidence, and a change only once a person approves it.",
  "purpose": "To answer whether a plugin is worth having, from evidence the platform already holds — what its real runs did — against a protocol somebody agreed before the scoring started, and to turn a plugin-owned defect into a candidate patch with independent proof before anyone approves promoting it. Measurement never bends toward the change somebody already wanted; promotion never happens without the required owners' say-so.",
  "entry": "zz-plugin-eval",
  "commands": {
    "eval": "zz-plugin-eval"
  },
  "servers": [
    {
      "name": "zz-plugin-eval",
      "path": "/eval/mcp"
    }
  ],
  "stages": [
    {
      "name": "zz-plugin-identify",
      "produces": "record"
    },
    {
      "name": "zz-plugin-observe",
      "produces": "record"
    },
    {
      "name": "zz-plugin-discover",
      "produces": "record"
    },
    {
      "name": "zz-plugin-define-qualify",
      "produces": "protocol.md"
    },
    {
      "name": "zz-plugin-evaluate",
      "produces": "record"
    },
    {
      "name": "zz-plugin-explain",
      "produces": "findings.md"
    },
    {
      "name": "zz-plugin-improve",
      "produces": "proposal.md"
    },
    {
      "name": "zz-plugin-promote-verify",
      "produces": "improvement.md"
    }
  ],
  "documents": [
    {
      "name": "protocol.md",
      "role": "agreement",
      "gate": true,
      "when": {
        "protocol_action": ["create", "revise"]
      },
      "sections": [
        "The plugin under evaluation",
        "What good means here",
        "The evidence each dimension reads"
      ],
      "stage": "zz-plugin-define-qualify"
    },
    {
      "name": "findings.md",
      "role": "verification",
      "requires": "protocol.md",
      "requiredForClose": true,
      "sections": [
        "Score",
        "Dimensions",
        "Guardrails",
        "Evaluator trust",
        "Strengths",
        "Defects",
        "Unknowns",
        "Ownership"
      ],
      "gate": false,
      "stage": "zz-plugin-explain"
    },
    {
      "name": "proposal.md",
      "role": "proposal",
      "requires": "findings.md",
      "requiredForClose": true,
      "when": {
        "release_mode": "proposal_only"
      },
      "sections": [
        "Subject",
        "Findings",
        "Candidates",
        "Ownership and promotion"
      ],
      "gate": false,
      "stage": "zz-plugin-improve"
    },
    {
      "name": "improvement.md",
      "role": "agreement",
      "requires": "findings.md",
      "closing": true,
      "requiredForClose": true,
      "when": {
        "release_mode": "promotable"
      },
      "sections": [
        "Candidate",
        "Base subject",
        "Patch",
        "Proof result",
        "Score change",
        "Guardrails",
        "Owners",
        "Release plan",
        "Rollback plan"
      ],
      "gate": true,
      "stage": "zz-plugin-promote-verify"
    }
  ],
  "license": "MIT"
}
