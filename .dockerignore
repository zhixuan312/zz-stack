# What must NOT enter the build context.
#
# The build runs `tsc -b`, which is incremental: a local dist/ or .tsbuildinfo in the context
# would let tsc decide there is nothing to recompile. Everything below is either regenerated
# inside the build or has no business in an image.
node_modules
**/node_modules
dist
**/dist
*.tsbuildinfo
**/*.tsbuildinfo

.git
.gitignore
.github

# Working material, never part of a release.
runs
docs
.claude
testing
scripts

# Fixtures. `COPY catalog /catalog` takes the whole tree, and nothing at runtime reads a flow's
# tests directory.
catalog/**/tests

# Local environment and build output.
deploy/.env
deploy/.env.*
dist/release
*.tgz
.DS_Store
